{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and grade details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "grade": { "type": "string" },
        "streakDays": { "type": "number" },
        "points": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Tracks student activity and score in subjects",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "solvedCount": { "type": "number" },
        "score": { "type": "number" },
        "lastActive": { "type": "string" }
      },
      "required": ["userId", "subject"]
    },
    "SavedQuestion": {
      "title": "SavedQuestion",
      "description": "Questions saved by student or solved by AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "question"]
    },
    "ClassRoom": {
      "title": "ClassRoom",
      "description": "Teacher classes and invite codes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "teacherId": { "type": "string" },
        "inviteCode": { "type": "string" },
        "studentCount": { "type": "number" },
        "subject": { "type": "string" },
        "grade": { "type": "string" }
      },
      "required": ["id", "name", "teacherId", "inviteCode"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/progress/{progressId}": {
      "schema": { "$ref": "#/entities/StudentProgress" },
      "description": "Student progress records"
    },
    "/savedQuestions/{questionId}": {
      "schema": { "$ref": "#/entities/SavedQuestion" },
      "description": "Student saved questions"
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassRoom" },
      "description": "Teacher classes collection"
    }
  }
}
